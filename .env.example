MONGODB_URI=mongodb://127.0.0.1:27017/table-for-all
SESSION_SECRET=replace-with-a-long-random-value
PORT=3000
NODE_ENV=development

# Resend email verification
RESEND_API_KEY=re_replace_with_your_resend_key
EMAIL_FROM=TableForAll <noreply@your-verified-domain.example>
APP_BASE_URL=http://localhost:3000
DEV_LOG_VERIFICATION_CODES=false

# SendGrid HTTPS alternative for hosts that block SMTP (supports Single Sender Verification)
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_key

# Gmail SMTP alternative for local use or hosts that permit SMTP
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-character-google-app-password

# Optional member meal assistant
OPENAI_API_KEY=sk-replace_with_your_openai_key
OPENAI_MODEL=replace-with-a-model-available-to-your-project
